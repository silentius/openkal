# Paths to your existing KalOnline assets. Absolute paths are recommended.
name=default
data_root=/path/to/KalOnline/data
map_root=/path/to/KalOnline/map
maps_subdir=MAPS
# Default virtual path for area maps in a locally combined config.pak.
# Point it at a compatible external area-map directory if needed.
server_map_root=/usr/share/openkal/RuntimeData/areas

# The packaged OpenKal configuration is used automatically. Uncomment this only
# to use a loose OpenKal configuration directory instead.
# configuration_root=/path/to/openkal/config
origin_patch=32

# Default fallback for new characters and invalid saved positions.
# Custom worlds should set their own safe starting position.
spawn_name=Narootuh
spawn_server_x=257285
spawn_server_y=258744
spawn_server_z=16100

# offline = viewer only; single = embedded MainSvr; multi = remote MainSvr.
play_mode=single
store_backend=sqlite
server_unix_path=

network_enabled=0
network_host=127.0.0.1
network_port=30001

# Client display, world streaming, effects, and audio.
client.settings_version=2
client.display.mode=windowed
client.display.width=1920
client.display.height=1080
client.quality.preset=medium
client.world.view_distance_tiles=2
client.world.preload_margin_tiles=0
client.world.resident_tile_limit=25
client.world.upload_budget_ms=1.50
client.world.animation_distance=300
client.world.effect_distance=300
client.audio.effect_volume=5
client.audio.bgm_volume=5
client.audio.bgm_enabled=1
