    {"type": "button", "x": 548, "y": 166, "w": 38, "h": 28, "file_default": "dragon_dialog/icon_button_idle.bmp", "label": "${settings.next}", "align": "center", "action": "settings.resolution.next", "visible_when": "settings.page.display", "file_over": "dragon_dialog/icon_button_hover.bmp", "file_on": "dragon_dialog/icon_button_pressed.bmp", "file_off": "dragon_dialog/icon_button_disabled.bmp", "id": "control_11", "pixel_size": 13},
    {"type": "text", "x": 30, "y": 106, "text": "${settings.world_heading}", "color": "${theme.colors.title}", "pixel_size": 15, "bold": true, "visible_when": "settings.page.world"},
