{
  "_doc": "In-game client settings. Values are edited as a draft and saved to the active profile.",
  "schema": "openkal.ui/v1",
  "id": "settings",
  "kind": "window",
  "window": {
    "w": 640,
    "h": 480,
    "draggable": false
  },
  "theme": {
    "font_pixel_size": 13,
    "colors": {
      "label": "#BDAE92",
      "value": "#EAE3D4",
      "pending": "#B5D991",
      "title": "#E5CF9E"
    }
  },
  "chrome": {
    "kind": "nine_slice",
    "preset": "dragon_dialog",
    "edges": "repeat",
    "pad_left": 40,
    "pad_top": 84,
    "pad_right": 40,
    "pad_bottom": 56,
    "close": false
  },
  "widgets": [
    {"type": "image", "id": "dialog_icon", "file": "dragon_menu/system.bmp", "x": 15, "y": -30, "w": 32, "h": 32},
    {"type": "text", "id": "title", "x": 96, "y": -41, "text": "${settings.title}", "color": "${theme.colors.title}", "pixel_size": 18, "bold": true},
    {"type": "tabs", "id": "settings_tabs", "bind": "settings.tab", "y": 52, "h": 30, "color_on": "#E5CF9E", "color_off": "#BDAE92", "items": [{"id": "display", "x": 20, "w": 88, "label": "${settings.display_heading}", "file_on": "dragon_dialog/button_pressed.bmp", "file_off": "dragon_dialog/button_idle.bmp"}, {"id": "world", "x": 112, "w": 88, "label": "${settings.world_tab}", "file_on": "dragon_dialog/button_pressed.bmp", "file_off": "dragon_dialog/button_idle.bmp"}, {"id": "render", "x": 204, "w": 88, "label": "${settings.render_tab}", "file_on": "dragon_dialog/button_pressed.bmp", "file_off": "dragon_dialog/button_idle.bmp"}, {"id": "audio", "x": 296, "w": 88, "label": "${settings.audio_heading}", "file_on": "dragon_dialog/button_pressed.bmp", "file_off": "dragon_dialog/button_idle.bmp"}], "align": "center", "pixel_size": 13},
    {"type": "tabs", "id": "battle_tab", "bind": "settings.tab", "y": 52, "h": 30, "color_on": "#E5CF9E", "color_off": "#BDAE92", "items": [{"id": "battle", "x": 388, "w": 140, "label": "${settings.battle_heading}", "file_on": "dragon_dialog/button_pressed.bmp", "file_off": "dragon_dialog/button_idle.bmp"}], "align": "center", "pixel_size": 13, "visible_when": "settings.battle_available"},
    {"type": "button", "id": "battle_tab_disabled", "x": 388, "y": 52, "w": 140, "h": 30, "label": "${settings.battle_heading}", "align": "center", "pixel_size": 13, "color": "#777777", "file_default": "dragon_dialog/button_disabled.bmp", "visible_when": "settings.battle_unavailable"},
    {"type": "tabs", "id": "misc_tab", "bind": "settings.tab", "y": 52, "h": 30, "color_on": "#E5CF9E", "color_off": "#BDAE92", "items": [{"id": "misc", "x": 532, "w": 88, "label": "${settings.misc_heading}", "file_on": "dragon_dialog/button_pressed.bmp", "file_off": "dragon_dialog/button_idle.bmp"}], "align": "center", "pixel_size": 13},
    {"type": "text", "id": "misc_heading", "x": 30, "y": 106, "text": "${settings.misc_heading}", "color": "${theme.colors.title}", "pixel_size": 15, "bold": true, "visible_when": "settings.page.misc"},
    {"type": "text", "id": "ignore_party_label", "x": 48, "y": 142, "text": "${settings.ignore_party_label}", "color": "${theme.colors.label}", "pixel_size": 13, "visible_when": "settings.page.misc"},
    {"type": "button", "id": "ignore_party", "x": 440, "y": 132, "w": 146, "h": 28, "label": "${settings.ignore_party}", "align": "center", "action": "settings.misc.ignore_party", "file_default": "dragon_dialog/button_idle.bmp", "file_over": "dragon_dialog/button_hover.bmp", "file_on": "dragon_dialog/button_pressed.bmp", "visible_when": "settings.page.misc", "pixel_size": 13},
    {"type": "text", "id": "clock_label", "x": 48, "y": 181, "text": "${settings.clock_label}", "color": "${theme.colors.label}", "pixel_size": 13, "visible_when": "settings.page.misc"},
    {"type": "button", "id": "clock_enabled", "x": 440, "y": 173, "w": 28, "h": 28, "label": "${settings.clock_checked}", "align": "center", "action": "settings.misc.clock", "file_default": "dragon_dialog/icon_button_idle.bmp", "file_over": "dragon_dialog/icon_button_hover.bmp", "file_on": "dragon_dialog/icon_button_pressed.bmp", "visible_when": "settings.page.misc", "pixel_size": 13},
    {"type": "text", "id": "show_own_name_label", "x": 48, "y": 220, "text": "${settings.show_own_name_label}", "color": "${theme.colors.label}", "pixel_size": 13, "visible_when": "settings.page.misc"},
    {"type": "button", "id": "show_own_name", "x": 440, "y": 212, "w": 28, "h": 28, "label": "${settings.show_own_name_checked}", "align": "center", "action": "settings.misc.show_own_name", "file_default": "dragon_dialog/icon_button_idle.bmp", "file_over": "dragon_dialog/icon_button_hover.bmp", "file_on": "dragon_dialog/icon_button_pressed.bmp", "visible_when": "settings.page.misc", "pixel_size": 13},
    {"type": "text", "id": "target_hp_display_label", "x": 48, "y": 259, "text": "${settings.target_hp_display_label}", "color": "${theme.colors.label}", "pixel_size": 13, "visible_when": "settings.page.misc"},
    {"type": "tabs", "id": "target_hp_display", "bind": "settings.target_hp_display", "y": 284, "h": 28, "color_on": "#E5CF9E", "color_off": "#BDAE92", "align": "center", "pixel_size": 13, "visible_when": "settings.page.misc", "items": [
      {"id": "standard", "x": 48, "w": 128, "label": "${settings.target_hp_display.standard}", "file_on": "dragon_dialog/button_pressed.bmp", "file_off": "dragon_dialog/button_idle.bmp"},
      {"id": "target_widget", "x": 184, "w": 128, "label": "${settings.target_hp_display.target_widget}", "file_on": "dragon_dialog/button_pressed.bmp", "file_off": "dragon_dialog/button_idle.bmp"},
      {"id": "large_bar", "x": 320, "w": 128, "label": "${settings.target_hp_display.large_bar}", "file_on": "dragon_dialog/button_pressed.bmp", "file_off": "dragon_dialog/button_idle.bmp"},
      {"id": "side_widget", "x": 456, "w": 130, "label": "${settings.target_hp_display.side_widget}", "file_on": "dragon_dialog/button_pressed.bmp", "file_off": "dragon_dialog/button_idle.bmp"}
    ]},
    {"type": "text", "x": 30, "y": 106, "text": "${settings.display_heading}", "color": "${theme.colors.title}", "pixel_size": 15, "bold": true, "visible_when": "settings.page.display"},
    {"type": "text", "x": 48, "y": 142, "text": "${settings.mode_label}", "color": "${theme.colors.label}", "visible_when": "settings.page.display", "pixel_size": 13},
    {"type": "text", "x": 386, "y": 142, "text": "${settings.mode}", "align": "center", "color": "${theme.colors.value}", "visible_when": "settings.page.display", "pixel_size": 13},
    {"type": "button", "x": 500, "y": 132, "w": 38, "h": 28, "file_default": "dragon_dialog/icon_button_idle.bmp", "label": "${settings.previous}", "align": "center", "action": "settings.display.previous", "visible_when": "settings.page.display", "file_over": "dragon_dialog/icon_button_hover.bmp", "file_on": "dragon_dialog/icon_button_pressed.bmp", "file_off": "dragon_dialog/icon_button_disabled.bmp", "id": "control_6", "pixel_size": 13},
    {"type": "button", "x": 548, "y": 132, "w": 38, "h": 28, "file_default": "dragon_dialog/icon_button_idle.bmp", "label": "${settings.next}", "align": "center", "action": "settings.display.next", "visible_when": "settings.page.display", "file_over": "dragon_dialog/icon_button_hover.bmp", "file_on": "dragon_dialog/icon_button_pressed.bmp", "file_off": "dragon_dialog/icon_button_disabled.bmp", "id": "control_7", "pixel_size": 13},
    {"type": "text", "x": 48, "y": 176, "text": "${settings.resolution_label}", "color": "${theme.colors.label}", "visible_when": "settings.page.display", "pixel_size": 13},
    {"type": "text", "x": 386, "y": 176, "text": "${settings.resolution}", "align": "center", "color": "${theme.colors.value}", "visible_when": "settings.page.display", "pixel_size": 13},
