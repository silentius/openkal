{
  "schema": "openkal.ui/v1",
  "id": "clock_event_options",
  "kind": "hud",
  "window": {
    "w": 188,
    "h": 172,
    "draggable": false
  },
  "theme": {
    "font_pixel_size": 11,
    "colors": {
      "title": "#E5CF9E",
      "label": "#BDAE92",
      "value": "#EAE3D4"
    }
  },
  "chrome": {
    "kind": "pieces",
    "pieces": []
  },
  "widgets": [
    {
      "type": "fill",
      "id": "background",
      "x": 0,
      "y": 0,
      "w": 188,
      "h": 172,
      "color": "#100F0C",
      "alpha": 1
    },
    {
      "type": "button",
      "id": "option_0",
      "x": 4,
      "y": 4,
      "w": 180,
      "h": 23,
      "action": "clock.choose.0",
      "label": "${clock.option.0}",
      "align": "center",
      "pixel_size": 11,
      "file_default": "dragon_dialog/button_idle.bmp",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "visible_when": "clock.option.0.visible"
    },
    {
      "type": "button",
      "id": "option_1",
      "x": 4,
      "y": 27,
      "w": 180,
      "h": 23,
      "action": "clock.choose.1",
      "label": "${clock.option.1}",
      "align": "center",
      "pixel_size": 11,
      "file_default": "dragon_dialog/button_idle.bmp",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "visible_when": "clock.option.1.visible"
    },
    {
      "type": "button",
      "id": "option_2",
      "x": 4,
      "y": 50,
      "w": 180,
      "h": 23,
      "action": "clock.choose.2",
      "label": "${clock.option.2}",
      "align": "center",
      "pixel_size": 11,
      "file_default": "dragon_dialog/button_idle.bmp",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "visible_when": "clock.option.2.visible"
    },
    {
      "type": "button",
      "id": "option_3",
      "x": 4,
      "y": 73,
      "w": 180,
      "h": 23,
      "action": "clock.choose.3",
      "label": "${clock.option.3}",
      "align": "center",
      "pixel_size": 11,
      "file_default": "dragon_dialog/button_idle.bmp",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "visible_when": "clock.option.3.visible"
    },
    {
      "type": "button",
      "id": "option_4",
      "x": 4,
      "y": 96,
      "w": 180,
      "h": 23,
      "action": "clock.choose.4",
      "label": "${clock.option.4}",
      "align": "center",
      "pixel_size": 11,
      "file_default": "dragon_dialog/button_idle.bmp",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "visible_when": "clock.option.4.visible"
    },
    {
      "type": "button",
      "id": "option_5",
      "x": 4,
      "y": 119,
      "w": 180,
      "h": 23,
      "action": "clock.choose.5",
      "label": "${clock.option.5}",
      "align": "center",
      "pixel_size": 11,
      "file_default": "dragon_dialog/button_idle.bmp",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "visible_when": "clock.option.5.visible"
    },
    {
      "type": "button",
      "id": "previous",
      "x": 4,
      "y": 145,
      "w": 32,
      "h": 23,
      "action": "clock.previous",
      "label": "${clock.previous}",
      "align": "center",
      "pixel_size": 12,
      "file_default": "dragon_dialog/button_idle.bmp",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "visible_when": "clock.paging"
    },
    {
      "type": "button",
      "id": "next",
      "x": 152,
      "y": 145,
      "w": 32,
      "h": 23,
      "action": "clock.next",
      "label": "${clock.next}",
      "align": "center",
      "pixel_size": 12,
      "file_default": "dragon_dialog/button_idle.bmp",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "visible_when": "clock.paging"
    },
    {
      "type": "text",
      "id": "page",
      "x": 94,
      "y": 151,
      "text": "${clock.page}",
      "color": "${theme.colors.label}",
      "align": "center",
      "visible_when": "clock.paging"
    },
    {
      "type": "border",
      "id": "frame",
      "x": 0,
      "y": 0,
      "w": 188,
      "h": 172,
      "thickness": 3,
      "top": "chatting-box-top.bmp",
      "bottom": "chatting-box-bottom.bmp",
      "left": "chatting-box-left.bmp",
      "right": "chatting-box-right.bmp"
    }
  ]
}
