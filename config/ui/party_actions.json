{
  "schema": "openkal.ui/v1",
  "id": "party_actions",
  "kind": "window",
  "window": {
    "w": 300,
    "h": 172,
    "draggable": false
  },
  "theme": {
    "font_pixel_size": 13,
    "colors": {
      "label": "#BDAE92",
      "value": "#EAE3D4",
      "title": "#E5CF9E"
    }
  },
  "chrome": {
    "kind": "nine_slice",
    "preset": "dragon_dialog",
    "edges": "repeat",
    "pad_left": 40,
    "pad_top": 84,
    "pad_right": 40,
    "pad_bottom": 56,
    "close": false
  },
  "widgets": [
    {
      "type": "image",
      "id": "dialog_icon",
      "file": "dragon_menu/party.bmp",
      "x": 15,
      "y": -30,
      "w": 32,
      "h": 32
    },
    {
      "type": "text",
      "id": "title",
      "x": 96,
      "y": -41,
      "text": "${party.title}",
      "pixel_size": 18,
      "bold": true,
      "color": "${theme.colors.title}"
    },
    {
      "type": "text",
      "id": "role",
      "x": 0,
      "y": 50,
      "text": "${party.role}",
      "pixel_size": 13,
      "color": "${theme.colors.title}"
    },
    {
      "type": "text",
      "id": "count",
      "x": 300,
      "y": 50,
      "text": "${party.count}",
      "align": "right",
      "pixel_size": 12,
      "color": "${theme.colors.label}"
    },
    {
      "type": "button",
      "id": "invite",
      "x": 0,
      "y": 80,
      "w": 300,
      "h": 28,
      "label": "${party.invite_label}",
      "action": "party.invite",
      "align": "center",
      "pixel_size": 13,
      "file_default": "dragon_dialog/button_idle.bmp",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "file_off": "dragon_dialog/button_disabled.bmp",
      "visible_when": "party.is_leader"
    },
    {
      "type": "fill",
      "id": "divider",
      "x": 0,
      "y_from_bottom": 46,
      "w": 300,
      "h": 1,
      "color": "#695137",
      "alpha": 0.8
    },
    {
      "type": "button",
      "id": "leave",
      "x": 82,
      "w": 136,
      "h": 28,
      "label": "${party.leave}",
      "action": "party.leave",
      "align": "center",
      "pixel_size": 13,
      "file_default": "dragon_dialog/button_idle.bmp",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "file_off": "dragon_dialog/button_disabled.bmp",
      "y_from_bottom": 36
    },
    {
      "type": "button",
      "id": "close",
      "x_from_right": 16,
      "y_from_bottom": 0,
      "w": 56,
      "h": 56,
      "action": "window.close",
      "file_default": "dragon_dialog/close_idle.bmp",
      "file_over": "dragon_dialog/close_hover.bmp",
      "file_on": "dragon_dialog/close_pressed.bmp"
    }
  ]
}
