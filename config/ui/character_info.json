{
  "_doc": "Dragon Character Info. Fixed artwork corners, resizable rails, TrueType content and an anchored footer close button.",
  "schema": "openkal.ui/v1",
  "id": "character_info",
  "kind": "window",
  "window": {
    "w": 420,
    "h": 560,
    "draggable": true,
    "title_drag_h": 70
  },
  "theme": {
    "font_pixel_size": 13,
    "colors": {
      "label": "#BDAE92",
      "value": "#EAE3D4",
      "pending": "#B5D991",
      "title": "#E5CF9E"
    }
  },
  "chrome": {
    "kind": "nine_slice",
    "preset": "dragon_dialog",
    "edges": "repeat",
    "pad_left": 40,
    "pad_top": 84,
    "pad_right": 40,
    "pad_bottom": 56,
    "close": false
  },
