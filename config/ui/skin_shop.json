{
  "_doc": "OpenKal ticket exchange with character mirror and model thumbnail catalog. Standard universal UI widgets and TrueType text.",
  "schema": "openkal.ui/v1",
  "id": "skin_shop",
  "kind": "window",
  "window": {
    "w": 880,
    "h": 620,
    "draggable": true,
    "title_drag_h": 40
  },
  "theme": {
    "font_pixel_size": 13
  },
  "chrome": {
    "kind": "nine_slice",
    "preset": "dragon_dialog",
    "edges": "repeat",
    "pad_left": 40,
    "pad_top": 84,
    "pad_right": 40,
    "pad_bottom": 56,
    "close": false
  },
  "widgets": [
    {
      "type": "image",
      "id": "dialog_icon",
      "file": "skinTicket.bmp",
      "x": 15,
      "y": -30,
      "w": 32,
      "h": 32
    },
    {
      "type": "text",
      "id": "title",
      "x": 440,
      "y": -41,
      "w": 880,
      "h": 24,
      "text": "${skin_shop.title}",
      "pixel_size": 18,
      "color": "#E5CF9E",
      "align": "center"
    },
    {
      "type": "button",
      "id": "weapons",
      "x": 310,
      "y": 24,
      "w": 170,
      "h": 30,
      "label": "${skin_shop.weapons}",
      "action": "skin_shop.weapons",
      "align": "center",
      "pixel_size": 13,
      "file_default": "dragon_dialog/button_idle.bmp",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "file_off": "dragon_dialog/button_disabled.bmp"
    },
    {
      "type": "button",
      "id": "full",
      "x": 490,
      "y": 24,
      "w": 170,
      "h": 30,
      "label": "${skin_shop.full}",
      "action": "skin_shop.full",
      "align": "center",
      "pixel_size": 13,
      "file_default": "dragon_dialog/button_idle.bmp",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "file_off": "dragon_dialog/button_disabled.bmp"
    },
    {
      "type": "button",
      "id": "parts",
      "x": 670,
      "y": 24,
      "w": 170,
      "h": 30,
      "label": "${skin_shop.parts}",
      "action": "skin_shop.parts",
      "align": "center",
      "pixel_size": 13,
      "file_default": "dragon_dialog/button_idle.bmp",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "file_off": "dragon_dialog/button_disabled.bmp"
    },
    {
      "type": "canvas",
      "id": "mirror",
      "bind": "skin_shop.mirror",
      "x": 18,
      "y": 70,
      "w": 276,
      "h": 414
    },
    {
      "type": "canvas",
      "id": "catalog",
      "bind": "skin_shop.catalog",
      "x": 310,
      "y": 70,
      "w": 550,
      "h": 460
    },
    {
      "type": "button",
      "id": "rotate_left",
      "x": 56,
      "y": 494,
      "w": 44,
      "h": 30,
      "label": "${skin_shop.rotate_left}",
      "action": "skin_shop.left",
      "align": "center",
      "pixel_size": 13,
      "file_default": "dragon_dialog/button_idle.bmp",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "file_off": "dragon_dialog/button_disabled.bmp"
    },
    {
      "type": "button",
