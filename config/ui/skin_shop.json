      "color": "#EAE3D4",
      "align": "left"
    },
    {
      "type": "text",
      "id": "cost",
      "x": 310,
      "y": 576,
      "w": 230,
      "h": 24,
      "text": "${skin_shop.cost}",
      "pixel_size": 13,
      "color": "#EAE3D4",
      "align": "left"
    },
    {
      "type": "button",
      "id": "redeem",
      "x": 590,
      "y": 575,
      "w": 126,
      "h": 30,
      "label": "${skin_shop.redeem}",
      "action": "skin_shop.redeem",
      "align": "center",
      "pixel_size": 13,
      "file_default": "dragon_dialog/button_idle.bmp",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "file_off": "dragon_dialog/button_disabled.bmp"
    },
    {
      "type": "button",
      "id": "close",
      "x": 732,
      "y": 575,
      "w": 126,
      "h": 30,
      "label": "${skin_shop.close}",
      "action": "skin_shop.close",
      "align": "center",
      "pixel_size": 13,
      "file_default": "dragon_dialog/button_idle.bmp",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "file_off": "dragon_dialog/button_disabled.bmp"
    },
    {
      "type": "text",
      "id": "hint",
      "x": 96,
      "y": 28,
      "w": 200,
      "h": 24,
      "text": "${skin_shop.hint}",
      "pixel_size": 12,
      "color": "#BDAE92",
      "align": "left"
    }
  ]
}
