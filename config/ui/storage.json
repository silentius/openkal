{
  "_doc": "Account storage uses the merchant two-pane composition. Both panes use the inventory grid without destroy affordances; all six storage registers are permanently enabled. Single stacks use a modal amount selector.",
  "schema": "openkal.ui/v1",
  "id": "storage",
  "kind": "window",
  "window": {
    "w": 552,
    "h": 433,
    "draggable": true,
    "title_drag_h": 44
  },
  "theme": {
    "font_pixel_size": 11,
    "colors": {
      "label": "#D9C59B",
      "value": "#FFF1C7",
      "title": "#FFE6A6",
      "pending": "#FFF0A0"
    }
  },
  "chrome": {
    "kind": "nine_slice",
    "preset": "info_menu",
    "close": true,
    "edges": "stretch",
    "pad_left": 10,
    "pad_top": 40,
    "pad_right": 7,
    "pad_bottom": 15
  },
  "widgets": [
    {
      "type": "fill",
      "id": "background_base",
      "x": 0,
      "y": 0,
      "w": 552,
      "h": 433,
      "color": "#080706"
    },
    {
      "type": "image",
      "id": "background",
      "x": 0,
      "y": 0,
      "w": 552,
      "h": 433,
      "file": "info-inventory-image.bmp",
      "source": { "x": 5, "y": 378, "w": 232, "h": 36 },
      "repeat": true
    },
    {
      "type": "image",
      "id": "inventory_background",
      "file": "info-inventory-image.bmp",
      "x": 18,
      "y": 8,
      "w": 245,
      "h": 417
    },
    {
      "type": "image",
      "id": "storage_background",
      "file": "info-inventory-image.bmp",
      "x": 289,
      "y": 8,
      "w": 245,
      "h": 417
    },
    {
      "type": "fill",
      "id": "inventory_hint_background_base",
      "x": 21,
      "y": 297,
      "w": 239,
      "h": 39,
      "color": "#080706",
      "alpha": 1
    },
    {
      "type": "image",
      "id": "inventory_hint_background",
      "x": 21,
      "y": 297,
      "w": 239,
      "h": 39,
      "alpha": 1,
      "file": "info-inventory-image.bmp",
      "source": { "x": 5, "y": 378, "w": 232, "h": 36 },
      "repeat": true
    },
    {
      "type": "fill",
      "id": "storage_hint_background_base",
      "x": 292,
      "y": 297,
      "w": 239,
      "h": 39,
      "color": "#080706",
      "alpha": 1
    },
    {
      "type": "image",
      "id": "storage_hint_background",
      "x": 292,
      "y": 297,
      "w": 239,
      "h": 39,
      "alpha": 1,
      "file": "info-inventory-image.bmp",
      "source": { "x": 5, "y": 378, "w": 232, "h": 36 },
      "repeat": true
    },
    {
      "type": "text",
      "id": "title",
      "x": 22,
      "y": -24,
      "text": "${storage.title}",
      "color": "${theme.colors.title}",
      "pixel_size": 13,
      "bold": true
    },
    {
      "type": "tabs",
      "id": "inventory_header_tab",
      "y": 14,
      "h": 27,
      "bind": "storage.inventory_tab",
      "color_off": "#C7BFA6",
      "color_on": "#FFFAEB",
      "items": [
        {
          "id": "inventory",
          "x": 21,
          "w": 76,
          "file_off": "info-tab1.bmp",
          "file_on": "info-tab1-on.bmp",
          "label": "${storage.inventory_label}"
        }
      ]
    },
    {
      "type": "tabs",
      "id": "storage_header_tab",
      "y": 14,
      "h": 27,
      "bind": "storage.storage_tab",
      "color_off": "#C7BFA6",
      "color_on": "#FFFAEB",
      "items": [
        {
          "id": "storage",
          "x": 292,
          "w": 76,
          "file_off": "info-tab1.bmp",
          "file_on": "info-tab1-on.bmp",
          "label": "${storage.storage_label}"
        }
      ]
    },
    {
      "type": "text",
      "id": "storage_count",
      "x": 520,
      "y": 16,
      "align": "right",
      "text": "${storage.count_text}",
      "color": "${theme.colors.label}"
    },
    {
      "type": "icon_grid",
      "id": "inventory",
      "x": 34,
      "y": 48,
      "cols": 6,
      "rows": 6,
      "cell": { "w": 32, "h": 32 },
      "pitch": { "x": 36, "y": 36 },
      "bind": "storage.inventory",
      "empty": { "file": "slot.bmp" },
      "select_color": "#F0D020",
      "tooltip": true,
      "badge": { "text": "${slot.count}", "visible_when": "slot.count > 1" }
    },
    {
      "type": "icon_grid",
      "id": "storage_items",
      "x": 305,
      "y": 48,
      "cols": 6,
      "rows": 6,
      "cell": { "w": 32, "h": 32 },
      "pitch": { "x": 36, "y": 36 },
      "bind": "storage.items",
      "empty": { "file": "slot.bmp" },
      "select_color": "#E9B83B",
      "tooltip": true,
      "badge": { "text": "${slot.count}", "visible_when": "slot.count > 1" }
    },
    {
      "type": "tabs",
      "id": "inventory_registers",
      "x": 0,
      "y": 278,
      "h": 17,
      "bind": "storage.inventory_page",
      "color_off": "#8A8374",
      "color_on": "#F2E6BF",
      "items": [
        { "id": "0", "x": 32, "w": 36, "file_off": "info-inventory-tab(off).bmp", "file_on": "info-inventory-tab(on).bmp", "label": "1" },
        { "id": "1", "x": 68, "w": 36, "file_off": "info-inventory-tab(off).bmp", "file_on": "info-inventory-tab(on).bmp", "label": "2" },
        { "id": "2", "x": 104, "w": 36, "file_off": "info-inventory-tab(off).bmp", "file_on": "info-inventory-tab(on).bmp", "label": "3" },
        { "id": "3", "x": 140, "w": 36, "file_off": "info-inventory-tab(off).bmp", "file_on": "info-inventory-tab(on).bmp", "label": "4" },
        { "id": "4", "x": 176, "w": 36, "file_off": "info-inventory-tab(off).bmp", "file_on": "info-inventory-tab(on).bmp", "label": "5" },
        { "id": "5", "x": 212, "w": 36, "file_off": "info-inventory-tab(off).bmp", "file_on": "info-inventory-tab(on).bmp", "label": "6" }
      ]
    },
    {
      "type": "tabs",
      "id": "storage_registers",
      "x": 0,
      "y": 278,
      "h": 17,
      "bind": "storage.page",
      "color_off": "#8A8374",
      "color_on": "#F2E6BF",
      "items": [
        { "id": "0", "x": 303, "w": 36, "file_off": "info-inventory-tab(off).bmp", "file_on": "info-inventory-tab(on).bmp", "label": "1" },
        { "id": "1", "x": 339, "w": 36, "file_off": "info-inventory-tab(off).bmp", "file_on": "info-inventory-tab(on).bmp", "label": "2" },
        { "id": "2", "x": 375, "w": 36, "file_off": "info-inventory-tab(off).bmp", "file_on": "info-inventory-tab(on).bmp", "label": "3" },
        { "id": "3", "x": 411, "w": 36, "file_off": "info-inventory-tab(off).bmp", "file_on": "info-inventory-tab(on).bmp", "label": "4" },
        { "id": "4", "x": 447, "w": 36, "file_off": "info-inventory-tab(off).bmp", "file_on": "info-inventory-tab(on).bmp", "label": "5" },
        { "id": "5", "x": 483, "w": 36, "file_off": "info-inventory-tab(off).bmp", "file_on": "info-inventory-tab(on).bmp", "label": "6" }
      ]
    },
    {
      "type": "text",
      "id": "fee",
      "x": 34,
      "y": 313,
      "text": "${storage.fee:geons}",
      "color": "${theme.colors.label}"
    },
    {
      "type": "text",
      "id": "money",
      "x": 206,
      "y": 353,
      "align": "right",
      "text": "${storage.money:geons}",
      "color": "${theme.colors.value}"
    },
    {
      "type": "image",
      "id": "money_icon",
      "file": "item001.bmp",
      "x": 208,
      "y": 351,
      "w": 16,
      "h": 16
    },
    {
      "type": "image",
      "id": "selected_name_field",
      "file": "info-menu-box(1row).bmp",
      "x": 291,
      "y": 347,
      "w": 239,
      "h": 23
    },
    {
      "type": "text",
      "id": "selected_name",
      "x": 299,
      "y": 352,
      "w": 223,
      "text": "${storage.selected_name}",
      "color": "${theme.colors.value}"
    },
    {
      "type": "button",
      "id": "deposit",
      "x": 141,
      "y": 389,
      "w": 111,
      "h": 28,
      "file_default": "B03-default.bmp",
      "file_off": "B03-off.bmp",
      "label": "Deposit →",
      "action": "storage.deposit",
      "align": "center"
    },
    {
      "type": "button",
      "id": "withdraw",
      "x": 412,
      "y": 389,
      "w": 111,
      "h": 28,
      "file_default": "B03-default.bmp",
      "file_off": "B03-off.bmp",
      "label": "← Withdraw",
      "action": "storage.withdraw",
      "align": "center"
    },
    {
      "type": "fill",
      "id": "quantity_shade",
      "x": 0,
      "y": 0,
      "w": 552,
      "h": 433,
      "color": "#000000",
      "alpha": 0.8,
      "visible_when": "storage.quantity_open"
    },
    {
      "type": "fill",
      "id": "quantity_panel_base",
      "x": 136,
      "y": 151,
      "w": 280,
      "h": 136,
      "color": "#080706",
      "alpha": 1,
      "visible_when": "storage.quantity_open"
    },
    {
      "type": "image",
      "id": "quantity_panel",
      "x": 136,
      "y": 151,
      "w": 280,
      "h": 136,
      "alpha": 1,
      "visible_when": "storage.quantity_open",
      "file": "info-inventory-image.bmp",
      "source": { "x": 5, "y": 378, "w": 232, "h": 36 },
      "repeat": true
    },
    {
      "type": "text",
      "id": "quantity_prompt",
      "x": 276,
      "y": 172,
      "align": "center",
      "text": "${storage.quantity_prompt}",
      "color": "${theme.colors.title}",
      "visible_when": "storage.quantity_open"
    },
    {
      "type": "button",
      "id": "quantity_decrease",
      "x": 167,
      "y": 202,
      "w": 42,
      "h": 28,
      "label": "-",
      "action": "storage.quantity.decrease",
      "visible_when": "storage.quantity_open",
      "file_default": "B03-default.bmp",
      "align": "center"
    },
    {
      "type": "input",
      "id": "quantity",
      "x": 276,
      "y": 208,
      "w": 70,
      "h": 20,
      "align": "center",
      "bind": "storage.quantity",
      "color": "${theme.colors.value}",
      "visible_when": "storage.quantity_open",
      "text": "${storage.quantity}"
    },
    {
      "type": "button",
      "id": "quantity_increase",
      "x": 343,
      "y": 202,
      "w": 42,
      "h": 28,
      "label": "+",
      "action": "storage.quantity.increase",
      "visible_when": "storage.quantity_open",
      "file_default": "B03-default.bmp",
      "align": "center"
    },
    {
      "type": "button",
      "id": "quantity_all",
      "x": 248,
      "y": 235,
      "w": 56,
      "h": 22,
      "label": "All",
      "action": "storage.quantity.all",
      "visible_when": "storage.quantity_open",
      "file_default": "B03-default.bmp",
      "align": "center"
    },
    {
      "type": "button",
      "id": "quantity_cancel",
      "x": 151,
      "y": 257,
      "w": 88,
      "h": 28,
      "file_default": "B03-default.bmp",
      "label": "Cancel",
      "action": "storage.quantity.cancel",
      "visible_when": "storage.quantity_open",
      "align": "center"
    },
    {
      "type": "button",
      "id": "quantity_confirm",
      "x": 313,
      "y": 257,
      "w": 88,
      "h": 28,
      "file_default": "B03-default.bmp",
      "label": "Confirm",
      "action": "storage.quantity.confirm",
      "visible_when": "storage.quantity_open",
      "align": "center"
    }
  ]
}
