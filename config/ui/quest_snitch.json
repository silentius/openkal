{
  "schema": "openkal.ui/v1",
  "id": "quest_snitch",
  "kind": "window",
  "window": {
    "w": 400,
    "h": 372,
    "draggable": true,
    "title_drag_h": 70
  },
  "theme": {
    "font_pixel_size": 13,
    "colors": {
      "label": "#BDAE92",
      "value": "#EAE3D4",
      "pending": "#B5D991",
      "title": "#E5CF9E"
    }
  },
  "chrome": {
    "kind": "nine_slice",
    "preset": "dragon_dialog",
    "edges": "repeat",
    "pad_left": 40,
    "pad_top": 84,
    "pad_right": 40,
    "pad_bottom": 56,
    "close": false
  },
  "widgets": [
    {
      "type": "text",
      "id": "title",
      "x": 96,
      "y": -41,
      "text": "${snitch.title}",
      "color": "${theme.colors.title}",
      "pixel_size": 18,
      "bold": true
    },
    {
      "type": "image",
      "id": "dialog_icon",
      "file": "dragon_menu/quest.bmp",
      "x": 15,
      "y": -30,
      "w": 32,
      "h": 32
    },
    {
      "type": "text",
      "id": "target",
      "x": 96,
      "y": 10,
      "text": "${snitch.target}",
      "color": "${theme.colors.title}"
    },
    {
      "type": "text",
      "id": "target_more",
      "x": 96,
      "y": 28,
      "text": "${snitch.target_more}",
      "color": "${theme.colors.title}"
    },
    {
      "type": "text",
      "id": "position",
      "x": 12,
      "y": 50,
      "text": "${snitch.position}",
      "color": "${theme.colors.label}"
    },
    {
      "type": "fill",
      "id": "map_background",
      "x": 12,
      "y": 78,
      "w": 376,
      "h": 236,
      "color": "#171714"
    },
    {
      "type": "canvas",
      "id": "map",
      "kind": "minimap",
      "bind": "snitch.map",
      "shape": "rect",
      "x": 12,
      "y": 78,
      "w": 376,
      "h": 236
    },
    {
      "type": "text",
      "id": "legend",
      "x": 12,
      "y": 324,
      "text": "${snitch.legend}",
      "color": "${theme.colors.label}"
    },
    {
      "type": "text",
      "id": "page",
      "x": 200,
      "y": 351,
      "text": "${snitch.page}",
      "align": "center",
      "visible_when": "snitch.multiple"
    },
    {
      "type": "button",
      "id": "previous",
      "y": 344,
      "w": 56,
      "h": 28,
      "label": "${snitch.previous}",
      "align": "center",
      "action": "snitch.previous",
      "file_default": "dragon_dialog/button_idle.bmp",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "file_off": "dragon_dialog/button_disabled.bmp",
      "x": 12,
      "visible_when": "snitch.multiple"
    },
    {
      "type": "button",
      "id": "next",
      "y": 344,
      "w": 56,
      "h": 28,
      "label": "${snitch.next}",
      "align": "center",
      "action": "snitch.next",
      "file_default": "dragon_dialog/button_idle.bmp",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "file_off": "dragon_dialog/button_disabled.bmp",
      "x": 332,
      "visible_when": "snitch.multiple"
    },
    {
      "type": "button",
      "id": "close",
      "x_from_right": 16,
      "y_from_bottom": 0,
      "w": 56,
      "h": 56,
      "action": "window.close",
      "file_default": "dragon_dialog/close_idle.bmp",
      "file_over": "dragon_dialog/close_hover.bmp",
      "file_on": "dragon_dialog/close_pressed.bmp",
      "file_off": "dragon_dialog/close_disabled.bmp"
    }
  ]
}
