{
  "_doc": "Reusable consumable recipe list. OpenKal layout; standard openkal.ui/v1 widgets and TrueType text. Recipe panels start below the upper-left frame ornament.",
  "schema": "openkal.ui/v1",
  "id": "consumable_crafting",
  "kind": "window",
  "window": {
    "w": 600,
    "h": 424,
    "draggable": true,
    "title_drag_h": 48
  },
  "theme": {
    "font_pixel_size": 13,
    "colors": {
      "title": "#E5CF9E",
      "label": "#BDAE92",
      "value": "#EAE3D4"
    }
  },
  "chrome": {
    "kind": "nine_slice",
    "preset": "dragon_dialog",
    "edges": "repeat",
    "pad_left": 40,
    "pad_top": 84,
    "pad_right": 40,
    "pad_bottom": 56,
    "close": false
  },
  "widgets": [
    {
      "type": "image",
      "id": "dialog_icon",
      "file": "dragon_menu/skill.bmp",
      "x": 15,
      "y": -30,
      "w": 32,
      "h": 32
    },
    {
      "type": "text",
      "id": "title",
      "x": 300,
      "y": -41,
      "w": 600,
      "h": 22,
      "align": "center",
      "text": "${crafting.title}",
      "color": "${theme.colors.title}",
      "pixel_size": 18,
      "bold": true
    },
    {
      "type": "fill",
      "id": "row_0_fill",
      "x": 12,
      "y": 48,
      "w": 576,
      "h": 74,
      "color": "#090807",
      "alpha": 0.65,
      "visible_when": "crafting.row.0.visible"
    },
    {
      "type": "text",
      "id": "row_0_title",
      "x": 24,
      "y": 56,
      "w": 440,
      "h": 18,
      "text": "${crafting.row.0.title}",
      "color": "${theme.colors.title}",
      "visible_when": "crafting.row.0.visible",
      "pixel_size": 13
