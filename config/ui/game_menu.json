{
  "_doc": "Modal ESC menu. Close switches to the confirmation widgets before the client exits.",
  "schema": "openkal.ui/v1",
  "id": "game_menu",
  "kind": "window",
  "window": {
    "w": 300,
    "h": 292,
    "draggable": false
  },
  "theme": {
    "font_pixel_size": 14,
    "colors": {
      "label": "#BDAE92",
      "value": "#EAE3D4",
      "pending": "#B5D991",
      "title": "#E5CF9E"
    }
  },
  "chrome": {
    "kind": "nine_slice",
    "preset": "dragon_dialog",
    "edges": "repeat",
    "pad_left": 40,
    "pad_top": 84,
    "pad_right": 40,
    "pad_bottom": 56,
    "close": false
  },
  "widgets": [
    {
      "type": "image",
      "id": "dialog_icon",
      "file": "dragon_menu/system.bmp",
      "x": 15,
      "y": -30,
      "w": 32,
      "h": 32
    },
    {
      "type": "text",
      "id": "title",
      "x": 96,
      "y": -41,
      "text": "${game_menu.title}",
      "color": "${theme.colors.title}",
      "pixel_size": 18,
      "bold": true
    },
    {
      "type": "button",
      "id": "cancel",
      "x": 30,
      "y": 64,
      "w": 240,
      "h": 38,
      "file_default": "dragon_dialog/button_idle.bmp",
      "label": "${game_menu.cancel}",
      "align": "center",
      "action": "game_menu.cancel",
      "visible_when": "game_menu.main",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "file_off": "dragon_dialog/button_disabled.bmp",
      "pixel_size": 14
    },
    {
      "type": "button",
      "id": "options",
      "x": 30,
      "y": 114,
      "w": 240,
      "h": 38,
      "file_default": "dragon_dialog/button_idle.bmp",
      "label": "${game_menu.options}",
      "align": "center",
      "action": "game_menu.options",
      "visible_when": "game_menu.main",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "file_off": "dragon_dialog/button_disabled.bmp",
      "pixel_size": 14
    },
    {
      "type": "button",
      "id": "select_character",
      "x": 30,
      "y": 164,
      "w": 240,
      "h": 38,
      "file_default": "dragon_dialog/button_idle.bmp",
      "label": "${game_menu.select_character}",
      "align": "center",
      "action": "game_menu.select_character",
      "visible_when": "game_menu.main",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "file_off": "dragon_dialog/button_disabled.bmp",
      "pixel_size": 14
    },
    {
      "type": "button",
      "id": "close",
      "x": 30,
      "y": 214,
      "w": 240,
      "h": 38,
      "file_default": "dragon_dialog/button_idle.bmp",
      "label": "${game_menu.close}",
      "align": "center",
      "action": "game_menu.close",
      "visible_when": "game_menu.main",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "file_off": "dragon_dialog/button_disabled.bmp",
      "pixel_size": 14
    },
    {
      "type": "text",
      "id": "close_question",
      "x": 150,
      "y": 110,
      "w": 240,
      "h": 28,
      "text": "${game_menu.close_question}",
      "align": "center",
      "color": "${theme.colors.value}",
      "visible_when": "game_menu.confirming",
      "pixel_size": 14
    },
    {
      "type": "button",
      "id": "close_yes",
      "x": 30,
      "y": 172,
      "w": 112,
      "h": 40,
      "file_default": "dragon_dialog/button_idle.bmp",
      "label": "${game_menu.yes}",
      "align": "center",
      "action": "game_menu.close_confirm",
      "visible_when": "game_menu.confirming",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "file_off": "dragon_dialog/button_disabled.bmp",
      "pixel_size": 14
    },
    {
      "type": "button",
      "id": "close_no",
      "x": 158,
      "y": 172,
      "w": 112,
      "h": 40,
      "file_default": "dragon_dialog/button_idle.bmp",
      "label": "${game_menu.no}",
      "align": "center",
      "action": "game_menu.close_cancel",
      "visible_when": "game_menu.confirming",
      "file_over": "dragon_dialog/button_hover.bmp",
      "file_on": "dragon_dialog/button_pressed.bmp",
      "file_off": "dragon_dialog/button_disabled.bmp",
      "pixel_size": 14
    }
  ]
}
