{
  "_doc": "Read-only Dragon material tables for NPC Upgrade and Create Weapon links. Rows are supplied by MixCatalog; nine recipes per page.",
  "schema": "openkal.ui/v1",
  "id": "mixing_item_list",
  "kind": "window",
  "window": {
    "w": 700,
    "h": 540,
    "draggable": true,
    "title_drag_h": 70
  },
  "theme": {
    "font_pixel_size": 13,
    "colors": {
      "label": "#BDAE92",
      "value": "#EAE3D4",
      "pending": "#B5D991",
      "title": "#E5CF9E",
      "active": "#B5D991"
    }
  },
  "chrome": {
    "kind": "nine_slice",
    "preset": "dragon_dialog",
    "edges": "repeat",
    "pad_left": 40,
    "pad_top": 84,
    "pad_right": 40,
    "pad_bottom": 56,
    "close": false
  },
  "widgets": [
    {
      "type": "image",
      "id": "dialog_icon",
      "file": "dragon_menu/skill.bmp",
      "x": 15,
      "y": -30,
      "w": 32,
      "h": 32
    },
    {
      "type": "text",
      "id": "title",
      "x": 96,
      "y": -41,
      "text": "${mix_list.title}",
      "pixel_size": 18,
      "align": "left",
      "color": "${theme.colors.title}",
      "bold": true
    },
    {
      "type": "button",
      "id": "upgrade",
      "x": 100,
      "y": 20,
      "w": 240,
      "h": 34,
      "label": "${mix_list.upgrade_label}",
      "action": "mix.list.upgrade",
      "align": "center",
      "pixel_size": 13,
      "color": "${mix_list.upgrade_color}",
      "file_default": "dragon_dialog/long_button_idle.bmp",
      "file_over": "dragon_dialog/long_button_hover.bmp",
      "file_on": "dragon_dialog/long_button_pressed.bmp",
      "file_off": "dragon_dialog/long_button_disabled.bmp"
    },
    {
      "type": "button",
      "id": "create",
      "x": 360,
      "y": 20,
      "w": 240,
      "h": 34,
